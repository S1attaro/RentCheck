# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# On the host, e.g. https://yourname.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Data APIs (see README "Data")
# https://app.rentcast.io/app/api  (free: 50 calls/month)
RENTCAST_API_KEY=
RENTCAST_MONTHLY_LIMIT=45
# https://www.huduser.gov/hudapi/public/register  (Fair Market Rent API)
HUD_API_TOKEN=
# https://collegescorecard.ed.gov/data/api-documentation/
SCORECARD_API_KEY=
# Optional: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Listing Reader (AI). https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
